# Backend application
MEDBOT_DATABASE_URL=postgresql+psycopg://medbot:local-only-medbot-password@postgres:5432/medbot
MEDBOT_AUTH_MODE=oidc
MEDBOT_DEV_TOKENS_JSON={}
MEDBOT_OIDC_ISSUER=http://localhost:8081/realms/medbot
MEDBOT_OIDC_AUDIENCE=medbot-api
MEDBOT_OIDC_JWKS_URL=http://keycloak:8080/realms/medbot/protocol/openid-connect/certs
MEDBOT_OBJECT_STORAGE=s3
MEDBOT_S3_ENDPOINT_URL=http://minio:9000
MEDBOT_S3_ACCESS_KEY_ID=local-medbot-minio-user
MEDBOT_S3_SECRET_ACCESS_KEY=local-only-minio-password
MEDBOT_S3_BUCKET=medbot-documents
MEDBOT_S3_REGION=us-east-1
MEDBOT_FHIR_BASE_URL=http://hapi-fhir:8080/fhir
MEDBOT_MAX_UPLOAD_BYTES=10485760
MEDBOT_DOCUMENT_EXTRACTOR=pdfium-tesseract
# fixture, ollama, openai, or gemini. Hosted providers require an explicit key and model.
MEDBOT_AI_PROVIDER=fixture
MEDBOT_AI_MODEL=qwen3:4b
MEDBOT_OLLAMA_BASE_URL=http://ollama:11434/v1
MEDBOT_OPENAI_API_KEY=
MEDBOT_GEMINI_API_KEY=
# Personal keys are encrypted; Compose supplies a separately persisted master-key file.
# Outside Compose configure one source only, from your secret manager:
# MEDBOT_PROVIDER_ENCRYPTION_KEY_FILE=/run/secrets/medbot-provider-key
# MEDBOT_PROVIDER_ENCRYPTION_KEY=
MEDBOT_CORS_ORIGINS=http://localhost:3000
OTEL_SERVICE_NAME=medbot-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318/v1/traces

# Local Docker Compose services; replace all values outside local development.
POSTGRES_ADMIN_PASSWORD=local-only-postgres-admin-password
MEDBOT_POSTGRES_DB=medbot
MEDBOT_POSTGRES_USER=medbot
MEDBOT_POSTGRES_PASSWORD=local-only-medbot-password
HAPI_POSTGRES_PASSWORD=local-only-hapi-password
KEYCLOAK_POSTGRES_PASSWORD=local-only-keycloak-db-password
KEYCLOAK_ADMIN_USERNAME=local-keycloak-admin
KEYCLOAK_ADMIN_PASSWORD=local-only-keycloak-admin-password
GRAFANA_ADMIN_USER=local-grafana-admin
GRAFANA_ADMIN_PASSWORD=local-only-grafana-password
